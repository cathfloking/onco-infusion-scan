{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "REPLACE_WITH_EXISTING_WORKER_NAME",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_EXISTING_DATABASE_NAME",
      "database_id": "REPLACE_WITH_EXISTING_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
